# ==============================================================================
# AgroControl Multimodal Engine - Environment Configuration Template
# Meta Global AI Developer Hackathon 2026 (Startup Track · Build for Your World)
# ==============================================================================

# Server Runtime Settings
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# AI Provider Orchestration & Multi-Tier Failover Strategy
# Primary Meta Models (SAM 3.1, Muse Glimmer, Muse Spark 1.3 / Muse Spark Open)
# with automatic failover across Meta API -> Modal GPU -> Fireworks -> Mock
# Supported providers: meta | modal | fireworks | mock
# ------------------------------------------------------------------------------
AI_VISION_PROVIDER=modal
AI_OCR_PROVIDER=modal
AI_AGENT_PROVIDER=fireworks

# Global Provider Fallback Sequence (Zero-Downtime Circuit Breaker)
AI_PROVIDER_PRIMARY=meta
AI_PROVIDER_FALLBACKS=modal,fireworks,mock

# Resilience & Circuit Breaker Settings
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
AI_RETRY_DELAY_MS=1000

# Image Optimization Settings for Vision Ingestion
IMAGE_MAX_WIDTH_PX=1280
IMAGE_JPEG_QUALITY=80

# ------------------------------------------------------------------------------
# Tier 1: Meta Official Model API (Primary Runtime Models)
# SAM 3.1 (Vision), Muse Glimmer (Document OCR), Muse Spark 1.3 (Agentic Chat)
# ------------------------------------------------------------------------------
META_API_KEY=your_meta_api_key_here
META_API_URL=https://api.meta.ai/v1
META_VISION_ENDPOINT=/sam3/predict
META_OCR_ENDPOINT=/glimmer/extract
META_AGENT_ENDPOINT=/spark/chat

# ------------------------------------------------------------------------------
# Tier 2: Modal Serverless Endpoints (Load-Bearing Meta Open-Weight Checkpoints)
# Runs modal_app/app.py: SAM 3.1, Muse Glimmer & Muse Spark Open
# ------------------------------------------------------------------------------
MODAL_API_KEY=your_modal_token_optional
MODAL_VISION_URL=https://agrocontrol-meta-ai-engine--agrocontrol-multimodal-sam3-predict.us-east.modal.run
MODAL_OCR_URL=https://agrocontrol-meta-ai-engine--agrocontrol-multimodal-glimm-66f1ce.us-east.modal.run
MODAL_AGENT_URL=https://agrocontrol-meta-ai-engine--agrocontrol-multimodal-spark-agent.us-east.modal.run

# ------------------------------------------------------------------------------
# Tier 3: Fireworks Serverless Inference (Open-Weight Runtime & Failover Backup)
# Runs Meta Open-Weight Muse Spark Open (accounts/fireworks/models/muse-spark-open)
# ------------------------------------------------------------------------------
FIREWORKS_API_KEY=your_fireworks_api_key_here
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_VISION_MODEL=accounts/fireworks/models/sam-3-vision
FIREWORKS_OCR_MODEL=accounts/fireworks/models/muse-glimmer-v1
FIREWORKS_AGENT_MODEL=accounts/fireworks/models/muse-spark-open
